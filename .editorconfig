root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_size = 2

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 140
ktlint_function_naming_ignore_when_annotated_with = Composable
# Files are named for what they do (HistoryGrouping.kt), not for their single class.
ktlint_standard_filename = disabled
